<odoo>

    <record id="view_fuel_consume_wizard_form" model="ir.ui.view">
        <field name="name">fuel.consume.wizard.form</field>
        <field name="model">fuel.consume.wizard</field>
        <field name="arch" type="xml">
            <form string="Fuel Consumption">
                <group>
                    <group string="Supply">
                        <field name="location_id" options="{'no_create': True}" />
                        <field name="available_qty" />
                    </group>
                    <group string="Consumption">
                        <field name="consume_qty" />
                        <field name="vehicle_id" options="{'no_create': True}" />
                        <field name="driver_id" options="{'no_create': True}" />
                        <field name="odometer" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_confirm_consumption"
                        type="object"
                        string="Confirm Consumption"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fuel_consume_wizard" model="ir.actions.act_window">
        <field name="name">Fuel Consumption</field>
        <field name="res_model">fuel.consume.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="groups_id"
            eval="[(4, ref('fuel_stock_consume.group_fuel_consumption_manager'))]"
        />
    </record>

    <menuitem
        id="menu_fuel_consume_wizard"
        name="Fuel Consumption"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_fuel_consume_wizard"
        sequence="30"
        groups="fuel_stock_consume.group_fuel_consumption_manager"
    />

</odoo>

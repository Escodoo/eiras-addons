<odoo>
    <record id="view_move_tree_inherit_fuel_register" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.fuel.register</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="initial_register_value" optional="hide" />
                <field name="final_register_value" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>

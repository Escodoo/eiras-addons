<odoo>
    <record id="stock_picking_form_inherit_fuel_register" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.fuel.register</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Register">
                    <group>
                        <field name="initial_register_value" />
                        <field name="final_register_value" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_tree_inherit_fuel_register" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.fuel.register</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="initial_register_value" optional="hide" />
                <field name="final_register_value" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>

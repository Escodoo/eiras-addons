<odoo>

    <record id="view_eiras_controlid_import_form" model="ir.ui.view">
        <field name="name">eiras.controlid.import.form</field>
        <field name="model">eiras.controlid.import</field>
        <field name="arch" type="xml">
            <form string="Import Control ID Attendance">
                <field name="state" invisible="1" />
                <group attrs="{'invisible': [('state', '!=', 'draft')]}">
                    <group string="File">
                        <field
                            name="csv_file"
                            filename="csv_filename"
                            widget="binary"
                            string="CSV File (Control ID)"
                        />
                        <field name="csv_filename" invisible="1" />
                    </group>
                    <group string="Import Options">
                        <field name="default_project_id" required="1" />
                        <field name="default_description" />
                        <field name="skip_existing" />
                    </group>
                </group>
                <div
                    class="alert alert-info"
                    role="alert"
                    attrs="{'invisible': [('state', '=', 'draft')]}"
                >
                    <group>
                        <group>
                            <field name="total_lines" readonly="1" />
                            <field name="found_lines" readonly="1" />
                            <field name="not_found_lines" readonly="1" />
                        </group>
                    </group>
                    <span
                    >Red rows indicate employees not found. You can link them manually before importing.</span>
                </div>
                <field
                    name="line_ids"
                    attrs="{'invisible': [('state', '=', 'draft')]}"
                    nolabel="1"
                >
                    <tree
                        editable="bottom"
                        decoration-danger="not employee_id"
                        decoration-muted="skip"
                    >
                        <field name="employee_name" />
                        <field name="employee_id" />
                        <field name="date" />
                        <field name="entry1" />
                        <field name="exit1" />
                        <field name="entry2" optional="show" />
                        <field name="exit2" optional="show" />
                        <field name="notes" optional="show" />
                        <field name="skip" />
                    </tree>
                </field>

                <footer>
                    <button
                        name="action_analyze"
                        type="object"
                        string="Analyze File"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_import"
                        type="object"
                        string="Import Records"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eiras_controlid_import" model="ir.actions.act_window">
        <field name="name">Import Control ID</field>
        <field name="res_model">eiras.controlid.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
